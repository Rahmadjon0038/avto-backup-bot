# === S3 / MinIO konfiguratsiyasi ===
# Mahalliy MinIO uchun manzil. Haqiqiy AWS S3'ga o'tganda bu qatorni butunlay
# bo'sh qoldiring (S3_ENDPOINT=) - kod avtomatik ravishda standart AWS
# endpoint'laridan foydalanadi.
S3_ENDPOINT=http://host.docker.internal:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=lms-backups
# AWS S3 uchun majburiy (masalan us-east-1). MinIO buni e'tiborsiz qoldiradi,
# lekin SDK talab qilgani uchun har doim biror qiymat bo'lishi kerak.
S3_REGION=us-east-1

# === Backup sozlamalari ===
# Har doim faqat so'nggi shuncha ta backup saqlanadi, qolgan eskilari
# bucket'dan avtomatik o'chiriladi (sanadan qat'iy nazar)
RETENTION_COUNT=2
# Cron ifodasi (standart: har kuni 23:00)
BACKUP_SCHEDULE=0 23 * * *
# Cron va log timestamp'lari uchun vaqt zonasi
TZ=Asia/Tashkent

# === Backup qilinadigan PostgreSQL konteyner ===
DB_CONTAINER_NAME=postgres16
DB_NAME=lms
DB_USER=postgres
# Faqat postgres16 ichida trust bo'lmagan auth ishlatilsa kerak bo'ladi.
# Bo'sh qoldirilsa, docker exec parolsiz (trust/peer auth) ishlaydi.
# DB_PASSWORD=

# === Log fayli (ixtiyoriy) ===
# Bo'sh qoldirilsa faqat konsolga (docker logs) yoziladi.
LOG_FILE=/app/logs/backup.log
